<Window x:Class="ColorPickerTray.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Height="380" Width="560">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Grid.Row="0" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                <DataGridTemplateColumn Header="颜色" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="24" Height="24" Background="{Binding Hex}" CornerRadius="4" BorderBrush="Black" BorderThickness="0.5" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="150" />
                <DataGridTextColumn Header="HSV" Binding="{Binding Hsv}" Width="120" />
                <DataGridTextColumn Header="RGB" Binding="{Binding Rgb}" Width="100" />
                <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="ExportButton" Content="导出 CSV" Width="100" Click="ExportButton_Click" Margin="0,0,8,0" />
            <Button x:Name="ClearButton" Content="清空历史" Width="100" Click="ClearButton_Click" Margin="0,0,8,0" />
            <Button Content="关闭" Width="80" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
