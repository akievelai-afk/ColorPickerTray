{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ColorPickerTray",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "src/ColorPickerTray/ColorPickerTray.csproj",
        "-c",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
